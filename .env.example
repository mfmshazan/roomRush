# Web (apps/web) — copy to apps/web/.env.local
# URL of the game server the browser connects to.
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Server (apps/server) — copy to apps/server/.env
# Port the game server listens on.
PORT=3001
# Allowed browser origin for CORS (the web app's URL).
CLIENT_ORIGIN=http://localhost:3000
